<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book List</title>
    <link rel="stylesheet" href="styles/styles.css">
</head>

<body>
    <div class="container">
        <h1>📚 My Book List</h1>
        <a href="/add" class="btn">Add New Book</a>
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Rating</th>
                    <th>Notes</th>
                    <th>Date Read</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% books.forEach(book=> { %>
                    <tr>
                        <td>
                            <%= book.title %>
                        </td>
                        <td>
                            <%= book.author %>
                        </td>
                        <td>
                            <%= book.rating %>
                        </td>
                        <td>
                            <%= book.notes %>
                        </td>
                        <td>
                        <%= book.date_read %> 
                        </td>
                        <td>
                            <a href="/edit/<%= book.id %>" class="btn btn-edit">Edit</a>
                            <form action="/delete/<%= book.id %>" method="POST" class="inline-form">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</body>

</html>


